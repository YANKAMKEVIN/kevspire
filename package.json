{
  "name": "kevspire",
  "version": "0.1.0",
  "description": "Kevspire : tower defense vertical original, jouable au doigt.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --trace off",
    "assets": "node tools/assets.mjs",
    "balance": "vite-node tools/balance.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.7",
    "eslint": "^9.39.5",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/nunito": "^5.3.0"
  },
  "private": true,
  "type": "module"
}
